    "femto-fsrs": "^2.0.0",
    "khmer-normalize": "^0.0.1",
    "khmer-normalizer": "^1.0.2",
    "marked": "^17.0.3",
    "match-sorter": "^8.2.0",
    "slugify-khmer": "^0.1.3",
    "sort-by": "^1.2.0",
    "tailwind-merge": "^3.0.0",
