{
  "name": "srghmakhmerdict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "my": "bash -c '(adb uninstall com.srghma.srghmakhmerdict || true) && gzip --force --keep --best ./src-tauri/dict.db > ./src-tauri/dict.dbgz && rm -frd src-tauri/gen/android/app/src/main/assets/ && RUST_BACKTRACE=1 pnpm tauri android dev'",
    "prod": "gzip --force --keep --best ./src-tauri/dict.db > ./src-tauri/dict.dbgz && rm -frd src-tauri/gen/android/app/src/main/assets/ && tauri android build --target aarch64 && (adb uninstall com.srghma.srghmakhmerdict || true) && adb install src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk"
  },
  "dependencies": {
